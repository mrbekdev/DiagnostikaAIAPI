# Server Configuration
PORT=3001
NODE_ENV=development
APP_NAME=Hududiy_SI_Mobil_Diagnostika
API_PREFIX=api/v1
CORS_ORIGIN=*

# PostgreSQL & Prisma
DATABASE_URL="postgresql://postgres@localhost:5433/mobil_diagnostika_db?schema=public"

# JWT Authentication
JWT_SECRET="super-secret-telemed-jwt-key-uzbekistan-2026-secure-random"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="super-refresh-telemed-jwt-key-uzbekistan-2026-secure"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis & BullMQ
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# MinIO / S3 Storage
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="medical-diagnostics"

# FastAPI Medical AI Microservice
FASTAPI_AI_URL="http://localhost:8000"
FASTAPI_TIMEOUT_MS=60000

# Telemedicine & WebRTC
WEBRTC_ICE_SERVERS="stun:stun.l.google.com:19302"
