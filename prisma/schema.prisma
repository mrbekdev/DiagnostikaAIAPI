generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  NURSE
  DOCTOR
  CARDIOLOGIST
  RADIOLOGIST
  ONCOLOGIST
  NEUROLOGIST
  USER
  PATIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ExaminationStatus {
  DRAFT
  PENDING_UPLOAD
  QUEUED
  PROCESSING
  ANALYZED
  DOCTOR_REVIEW
  COMPLETED
  REJECTED
}

enum FileType {
  XRAY
  ECG
  BLOOD
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DoctorDecision {
  APPROVED
  MODIFIED
  REANALYSIS_REQUESTED
  REJECTED
}

enum NotificationType {
  AI_FINISHED
  DOCTOR_REVIEWED
  EMERGENCY_CASE
  TELEMEDICINE_INVITE
  SYSTEM_ALERT
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  passwordHash     String
  fullName         String
  phone            String?
  role             UserRole     @default(NURSE)
  specialty        String?
  licenseNumber    String?
  digitalSignature String?      // Public key or signature fingerprint
  refreshTokenHash String?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  createdPatients     Patient[]             @relation("UserCreatedPatients")
  assignedClinics     MobileClinic[]        @relation("NurseAssignedClinics")
  conductedExams      Examination[]         @relation("NurseExaminations")
  doctorReviews       DoctorReview[]        @relation("DoctorReviews")
  telemedAsDoctor     TelemedicineSession[] @relation("DoctorTelemed")
  telemedAsNurse      TelemedicineSession[] @relation("NurseTelemed")
  sentMessages        ChatMessage[]         @relation("SentMessages")
  receivedMessages    ChatMessage[]         @relation("ReceivedMessages")
  auditLogs           AuditLog[]
  notifications       Notification[]

  @@map("users")
}

model MobileClinic {
  id              String         @id @default(uuid())
  name            String
  plateNumber     String         @unique
  region          String         // e.g. "Qoraqalpog'iston", "Surxondaryo", "Xorazm"
  district        String         // e.g. "Mo'ynoq", "Boysun", "Xiva"
  currentLat      Float          @default(41.2995)
  currentLng      Float          @default(69.2401)
  isOnline        Boolean        @default(false)
  lastPing        DateTime?
  assignedNurseId String?
  assignedNurse   User?          @relation("NurseAssignedClinics", fields: [assignedNurseId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  examinations    Examination[]

  @@map("mobile_clinics")
}

model Patient {
  id          String        @id @default(uuid())
  fullName    String
  pinfl       String        @unique // 14-digit national PINFL
  passport    String        // Passport / ID card (e.g. AA1234567)
  birthDate   DateTime
  age         Int
  gender      Gender
  region      String        // e.g., "Qashqadaryo"
  district    String        // e.g., "Dehqonobod"
  village     String        // Remote village/qishloq name (e.g., "Oqsuv")
  latitude    Float?
  longitude   Float?
  complaints  String?       @db.Text
  phone       String?
  createdById String
  createdBy   User          @relation("UserCreatedPatients", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  examinations Examination[]

  @@index([pinfl])
  @@index([passport])
  @@index([region, district, village])
  @@map("patients")
}

model Examination {
  id              String            @id @default(uuid())
  patientId       String
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinicId        String?
  clinic          MobileClinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  nurseId         String
  nurse           User              @relation("NurseExaminations", fields: [nurseId], references: [id])
  status          ExaminationStatus @default(DRAFT)
  priority        Int               @default(1) // 1=Low, 2=Medium, 3=High, 4=Critical
  riskLevel       RiskLevel?
  nurseNotes      String?           @db.Text
  syncId          String?           @unique // For offline reconciliation
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  uploads         Upload[]
  aiResults       AiResult[]
  doctorReviews   DoctorReview[]
  telemedSessions TelemedicineSession[]

  @@index([patientId])
  @@index([status])
  @@index([riskLevel])
  @@map("examinations")
}

model Upload {
  id            String      @id @default(uuid())
  examinationId String
  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  fileType      FileType
  originalName  String
  mimeType      String
  fileSize      Int
  minioKey      String      @unique
  previewKey    String?
  checksum      String?     // SHA256 for integrity & virus scan hook
  metadata      Json?       // DICOM headers, image dimension, ECG sample rate, etc.
  createdAt     DateTime    @default(now())

  aiResults     AiResult[]

  @@index([examinationId])
  @@map("uploads")
}

model AiResult {
  id                     String       @id @default(uuid())
  examinationId          String
  examination            Examination  @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  uploadId               String?
  upload                 Upload?      @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  confidence             Float        // Percentage e.g. 96.8
  riskLevel              RiskLevel
  findings               Json         // Structured findings array [{name, confidence, region}]
  overlayImageUrl        String?      @db.Text // Grad-CAM or heatmap image path in MinIO
  highlightedRegions     Json?        // Waveform timestamps or bounding boxes
  technicalSummary       String       @db.Text // Professional clinical English/Russian summary
  patientExplanationUzbek String      @db.Text // Simple, empathetic Uzbek explanation
  modelVersion           String       @default("v1.0.0-med")
  latencyMs              Int          @default(0)
  generatedAt            DateTime     @default(now())

  @@index([examinationId])
  @@map("ai_results")
}

model DoctorReview {
  id               String         @id @default(uuid())
  examinationId    String
  examination      Examination    @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  doctorId         String
  doctor           User           @relation("DoctorReviews", fields: [doctorId], references: [id])
  specialty        String
  decision         DoctorDecision @default(APPROVED)
  finalDiagnosis   String         @db.Text
  recommendations  String?        @db.Text
  notes            String?        @db.Text
  digitalSignature String         // Cryptographic signature hash
  approvedAt       DateTime       @default(now())

  @@index([examinationId])
  @@index([doctorId])
  @@map("doctor_reviews")
}

model TelemedicineSession {
  id            String       @id @default(uuid())
  examinationId String
  examination   Examination  @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        User         @relation("DoctorTelemed", fields: [doctorId], references: [id])
  nurseId       String
  nurse         User         @relation("NurseTelemed", fields: [nurseId], references: [id])
  roomName      String       @unique
  startedAt     DateTime     @default(now())
  endedAt       DateTime?
  durationSec   Int?
  notes         String?      @db.Text
  recordingKey  String?

  @@index([examinationId])
  @@map("telemedicine_sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // e.g. "PATIENT_CREATED", "FILE_UPLOADED", "AI_ANALYZED", "DOCTOR_APPROVED"
  resource   String   // e.g. "Patient", "Upload", "DoctorReview"
  resourceId String?
  ipAddress  String?
  userAgent  String?
  details    Json?
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String           @db.Text
  type      NotificationType @default(SYSTEM_ALERT)
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model ChatMessage {
  id          String   @id @default(uuid())
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content     String   @db.Text
  isRead      Boolean  @default(false)
  fileUrl     String?
  createdAt   DateTime @default(now())

  @@index([senderId, receiverId])
  @@index([receiverId])
  @@map("chat_messages")
}
